# ==========================================
# QuizVault Backend Cloud Environment Variables
# Copy these values into your Render Environment tab
# ==========================================

# 1. Database Connection URL
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-34461d99-examportal-013.g.aivencloud.com:20235/defaultdb?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# 2. Database Username
SPRING_DATASOURCE_USERNAME=avnadmin

# 3. Database Password
SPRING_DATASOURCE_PASSWORD=<YOUR_AIVEN_MYSQL_PASSWORD>

# 4. Hibernate Auto DDL
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 5. JWT Secret Key
JWT_SECRET=QuizVaultSuperSecretSigningKeyThatIsAtLeast32BytesLongForHS256Security!
