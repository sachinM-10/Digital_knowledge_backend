# ==========================================
# QuizVault Backend Cloud Environment Variables
# Copy these values into your Render Environment tab
# ==========================================

# 1. Database Connection URL (Replace HOST, PORT, and DBNAME with your MySQL details)
SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/defaultdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# 2. Database Username
SPRING_DATASOURCE_USERNAME=avnadmin

# 3. Database Password (Click 'Show' in Aiven MySQL overview to copy)
SPRING_DATASOURCE_PASSWORD=<YOUR_AIVEN_MYSQL_PASSWORD>

# 4. Hibernate Auto DDL
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 5. JWT Secret Key
JWT_SECRET=QuizVaultSuperSecretSigningKeyThatIsAtLeast32BytesLongForHS256Security!
